# Salin file ini ke .env.local dan isi nilainya
# JANGAN commit .env.local ke git

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# API Secret — string acak 32+ karakter
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET=ganti-dengan-string-acak-32-karakter

# Dikonsumsi Vite (build-time, masuk bundle) — HANYA API_SECRET
VITE_API_SECRET=ganti-dengan-string-acak-32-karakter
VITE_API_BASE_URL=http://localhost:5173
